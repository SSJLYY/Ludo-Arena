{
  "description": "飞行棋联机小程序（原生小程序 + 微信云开发）",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "tools"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "overview.md"
      }
    ],
    "include": []
  },
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "uglifyFileName": false,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "autoAudits": false,
    "urlCheck": true,
    "cloud": true
  },
  "libVersion": "2.33.0",
  "appid": "touristappid",
  "projectname": "flight-chess",
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
