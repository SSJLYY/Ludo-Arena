.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 8rpx 48rpx;
}

.hero-title {
  display: flex;
  flex-direction: column;
}

.hero-sub {
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 6rpx;
  margin-top: 8rpx;
}

.profile-chip {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 28rpx 12rpx 14rpx;
  box-shadow: 0 6rpx 20rpx rgba(35, 36, 58, 0.08);
}

.profile-meta {
  margin-left: 16rpx;
}

.profile-name {
  font-size: 26rpx;
  font-weight: 600;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.last-card {
  margin-bottom: 28rpx;
  padding: 26rpx 32rpx;
}

.last-info {
  margin-left: 20rpx;
}

.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #27ae60;
  animation: pulse 1.6s ease-out infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(39, 174, 96, 0.5); }
  100% { box-shadow: 0 0 0 18rpx rgba(39, 174, 96, 0); }
}

.main-btn {
  margin-bottom: 24rpx;
}

.join-card {
  margin-top: 28rpx;
}

.join-title {
  margin-bottom: 20rpx;
}

.join-no {
  margin-bottom: 20rpx;
  letter-spacing: 8rpx;
  font-weight: 600;
}

.join-card .btn {
  margin-top: 20rpx;
}

.footer-tip {
  text-align: center;
  color: var(--ink-3);
  font-size: 22rpx;
  margin-top: 60rpx;
  letter-spacing: 2rpx;
}

.form-row {
  margin: 28rpx 0;
}

.popup-title {
  text-align: center;
  margin-bottom: 12rpx;
}

.picker-value {
  color: var(--brand);
  font-weight: 600;
}

.popup-btn {
  margin-top: 40rpx;
}

/* 排行榜入口 */
.lb-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  margin-bottom: 28rpx;
}

.lb-trophy {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.lb-entry-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.lb-entry-arrow {
  color: var(--ink-3);
  font-size: 36rpx;
}

/* 排行榜弹层 */
.lb-refresh {
  font-size: 30rpx;
  padding: 6rpx 12rpx;
}

.lb-loading {
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
  padding: 40rpx 0;
}

.lb-start {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.lb-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.lb-row.me {
  background: rgba(232, 84, 63, 0.06);
  border-radius: 14rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.lb-row:last-of-type {
  border-bottom: none;
}

.lb-medal {
  width: 76rpx;
  text-align: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.lb-medal.plain {
  font-size: 28rpx;
  color: var(--ink-2);
  font-weight: 600;
}

.lb-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.lb-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lb-tier {
  font-size: 20rpx;
  color: var(--gold);
  border: 2rpx solid rgba(255, 176, 58, 0.4);
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  font-weight: 400;
}

.lb-rate {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
  flex-shrink: 0;
}

.lb-me {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand);
  background: rgba(232, 84, 63, 0.08);
  border-radius: 12rpx;
  padding: 14rpx 0;
}

/* 加入行 */
.join-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.join-row .join-no {
  flex: 1;
  margin-bottom: 0;
}

.paste-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand);
  background: rgba(232, 84, 63, 0.08);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
}

/* 首次引导 */
.guide-mask {
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.guide-popup {
  border-radius: 36rpx;
}

.guide-title {
  font-size: 40rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 30rpx;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  font-size: 27rpx;
  color: var(--ink-2);
  line-height: 1.7;
  margin: 20rpx 0;
}

.guide-num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-btn {
  margin-top: 30rpx;
}
