.gpage {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 玩家条 */
.players-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.p-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 14rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 3rpx solid transparent;
  opacity: 0.72;
  transition: all 0.25s;
}

.p-card.current {
  border-color: var(--pc);
  opacity: 1;
  box-shadow: 0 6rpx 18rpx rgba(35, 36, 58, 0.12);
}

.p-meta {
  margin-top: 8rpx;
  text-align: center;
  min-width: 0;
}

.p-name {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.p-nick {
  font-size: 20rpx;
  font-weight: 600;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-tag {
  font-size: 16rpx;
  color: var(--ink-3);
  border: 2rpx solid var(--line);
  border-radius: 6rpx;
  padding: 0 6rpx;
  flex-shrink: 0;
}

.tool.takeover {
  color: #fff;
  background: var(--brand);
}

.p-tag.owner {
  color: var(--gold);
  border-color: rgba(255, 176, 58, 0.5);
}

.p-tag.warn {
  color: #d43d2a;
  border-color: rgba(212, 61, 42, 0.4);
}

.p-done {
  font-size: 18rpx;
  color: var(--ink-2);
  margin-top: 4rpx;
}

.p-held {
  color: var(--gold);
}

/* 表情气泡 */
.emote-bubble {
  position: absolute;
  top: 130rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(35, 36, 58, 0.88);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  z-index: 40;
  animation: bubble-in 0.25s ease-out;
  max-width: 80%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes bubble-in {
  0% { transform: translateX(-50%) scale(0.6); opacity: 0; }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}

/* 棋盘 */
.board-wrap {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

/* 表情栏 */
.emote-bar {
  position: relative;
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.emote {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(35, 36, 58, 0.08);
}

.emote:active {
  transform: scale(1.15);
}

.emote-bar.cd .emote {
  opacity: 0.35;
}

.emote-cd {
  position: absolute;
  right: 0;
  top: -6rpx;
  font-size: 20rpx;
  color: #fff;
  background: var(--ink-2);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

/* 骰子历史条 */
.dice-hist {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.dh-label {
  font-size: 20rpx;
  color: var(--ink-3);
}

.dh-item {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--ink-2);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(35, 36, 58, 0.08);
}

.dh-item.latest {
  background: var(--brand);
  color: #fff;
  font-weight: 700;
}

/* 控制台 */
.ctrl {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(35, 36, 58, 0.07);
}

.ctrl-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hint {
  font-size: 26rpx;
  color: var(--ink-2);
  flex: 1;
}

.ctrl-actions {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.tool {
  font-size: 20rpx;
  color: var(--ink-2);
  background: #f7f5ee;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.tool.on {
  color: #fff;
  background: var(--brand);
}

.ctrl-main {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  gap: 28rpx;
}

.ctrl-side {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dice-label {
  font-size: 22rpx;
  color: var(--ink-3);
  writing-mode: vertical-lr;
  letter-spacing: 4rpx;
}

.roll-wrap {
  flex: 1;
}

.roll-btn {
  width: 100%;
}

.reroll-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  margin-top: 14rpx;
}

.exit {
  text-align: center;
  color: var(--ink-3);
  font-size: 22rpx;
  margin-top: 12rpx;
  text-decoration: underline;
}

/* 胜利横幅 */
.win-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 21, 35, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

/* 战况统计弹层 */
.stats-mask {
  align-items: center;
  justify-content: center;
}

.stats-mask .popup {
  border-radius: 32rpx;
  width: 86vw;
}

.stats-popup-title {
  text-align: center;
  margin-bottom: 24rpx;
}

.s-head,
.s-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.s-head {
  color: var(--ink-3);
  font-size: 22rpx;
  border-bottom: 2rpx solid var(--line);
}

.s-row {
  border-bottom: 2rpx solid var(--line);
  font-size: 26rpx;
}

.s-row:last-of-type {
  border-bottom: none;
}

.s-c {
  flex: 1.6;
  min-width: 0;
}

.s-n {
  flex: 1;
  text-align: center;
}

.s-p {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dot2 {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.stats-tip {
  text-align: center;
  margin-top: 16rpx;
}

.rule-item {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.9;
  margin-bottom: 6rpx;
}

.win-banner {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 64rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--brand);
  animation: pop 0.4s ease-out;
}

@keyframes pop {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
